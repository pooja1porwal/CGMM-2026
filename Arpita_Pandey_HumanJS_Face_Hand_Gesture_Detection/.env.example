# Application
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (leave blank for SQLite, or use PostgreSQL URL)
DATABASE_URL=

# ML Model
MODEL_PATH=artifacts/signspeak_model.joblib
MODEL_METADATA_PATH=artifacts/model_metadata.json

# Inference Configuration
# Minimum confidence for a frame to count toward the temporal-stability window used to commit a
# letter. The raw/display prediction is always shown to the user regardless of this value; it only
# gates commits. See reports/confidence_threshold_analysis.json for the validation-set analysis.
COMMIT_CONFIDENCE_THRESHOLD=0.50
STABILITY_WINDOW=7
STABILITY_MIN_COUNT=5
SIGN_COOLDOWN_MS=800
# Consecutive no-hand/low-confidence frames required before a held gesture is considered released.
RELEASE_FRAME_COUNT=3

# WebSocket
MAX_WEBSOCKET_MESSAGE_BYTES=5242880

# Logging
LOG_LEVEL=INFO

# Frontend API (for development)
VITE_API_URL=http://localhost:8000
